# Copy this file to a new file named ".env" and fill in your own values.
# Never upload .env to GitHub or put it in a ZIP.

PORT=3000

# MySQL (the same details you use in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=sifted_cafe_db

# Demo staff login (one shared account for the school project)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_password_here

# Leave empty on your own computer. Use "production" only when hosted with HTTPS.
NODE_ENV=

# Old reservations are deleted after this many months (the cafe said 6). Use 0 to never delete.
# RETENTION_MONTHS=6
